# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# API key Gemini — lấy tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Giữ = 0 nếu dùng Google AI Studio (không dùng Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=0

# (Tuỳ chọn) key Gemini dự phòng — khi key chính hết quota (429), code sẽ tự
# xoay sang các key này (xem src/core/config.py::rotate_google_api_key).
# Cách 1 — đánh số:
# GOOGLE_API_KEY_2=your-backup-key-2
# GOOGLE_API_KEY_3=your-backup-key-3
# Cách 2 — 1 dòng, phân cách bởi dấu phẩy (ưu tiên hơn nếu cả hai đều có):
# GOOGLE_API_KEY_POOL=key1,key2,key3
